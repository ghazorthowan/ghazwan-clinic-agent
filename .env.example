# ── Database ─────────────────────────────────────────────────────────────────
# For local dev, use the full URL:
DATABASE_URL=postgresql://clinic:clinic_dev_only@localhost:5432/clinic_booking

# For docker-compose.prod.yml, set these individually instead:
DB_USER=clinic
DB_PASSWORD=                        # Strong random password — required in production
DB_NAME=clinic_booking

# ── App URL & domain ─────────────────────────────────────────────────────────
# Public URL of the app — baked into the Docker image at build time.
NEXT_PUBLIC_APP_URL=https://clinic.example.com

# Domain used by Caddy for automatic HTTPS (must match your DNS A record).
DOMAIN=clinic.example.com

# ── Staff session (must be ≥ 32 random characters) ───────────────────────────
STAFF_SESSION_SECRET=change-me-to-a-random-32-char-secret

# ── First admin account (used by db:seed-admin script only) ──────────────────
ADMIN_EMAIL=admin@clinic.local
ADMIN_PASSWORD=ChangeMe2026!

# ── Internal services (shared secret for /api/ai/respond, /api/outbox, /api/sync/cron) ──
INTERNAL_API_SECRET=change-me-to-a-random-secret

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────────────────────
# Obtain from: Meta Business Manager → WhatsApp → API Setup
# WHATSAPP_ENABLED must be "true" to send real messages (CLAUDE.md rule 8).
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=                     # Permanent system user token from Meta
WHATSAPP_APP_SECRET=                # App secret from Meta App Dashboard → Settings → Basic
WHATSAPP_VERIFY_TOKEN=              # Any random string; paste into Meta webhook config

# Multi-number WhatsApp: JSON map of phone_number_id → channel (WA_01 / WA_02 / WA_03)
# Leave blank to route everything to WA_01 (single-number setup).
WA_PHONE_CHANNEL_MAP=               # e.g. {"123456789":"WA_01","987654321":"WA_02"}

# Approved utility template names (from Meta Business Manager → Message Templates)
WA_TEMPLATE_REENGAGEMENT=clinic_reengagement
WA_TEMPLATE_BOOKING_CONFIRM=clinic_booking_confirmation
WA_TEMPLATE_REMINDER=clinic_appointment_reminder

# ── Instagram Business + Facebook Messenger (Meta Social) ────────────────────
# Obtain from: Meta Business Manager → Facebook App → Webhooks → Instagram/Messenger
# Uses the same HMAC-SHA256 verification as WhatsApp.
META_APP_SECRET=                    # Facebook App secret (different from WhatsApp app)
META_VERIFY_TOKEN=                  # Any random string; paste into Facebook App webhook config

# ── Wix embeddable widget ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS + origin enforcement.
# Leave blank in development to allow all origins; MUST be set in production.
WIDGET_ALLOWED_ORIGINS=             # e.g. https://your-clinic.wixsite.com,https://www.yourclinic.com

# ── TikTok Business Messaging ────────────────────────────────────────────────
# Requires approved TikTok Business Messaging access (CLAUDE.md rule 2).
# TIKTOK_ENABLED must be "true" to activate the TikTok webhook.
TIKTOK_ENABLED=false
TIKTOK_APP_SECRET=                  # TikTok App secret for HMAC-SHA256 webhook verification

# ── Google Sheets sync (optional) ────────────────────────────────────────────
# Service account with Editor access to the spreadsheet.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEET_TAB=Bookings

# ── Claude AI ────────────────────────────────────────────────────────────────
# Obtain from: console.anthropic.com
ANTHROPIC_API_KEY=

# ── CORS / allowed origins (comma-separated, optional) ───────────────────────
ALLOWED_ORIGINS=
